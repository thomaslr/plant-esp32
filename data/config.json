{
  "system": {
    "hostname": "plants",
    "timezone": "Asia/Singapore",
    "gmt_offset": 8,
    "ntp_servers": [
      "time.google.com",
      "pool.ntp.org",
      "time.nist.gov"
    ],
    "monitoring_interval_sec": 60
  },
  "gauges": {
    "soil_moisture": {
      "trigger_threshold": 40,
      "dry_adc": 1950,
      "wet_adc": 670,
      "optimal_min": 35,
      "optimal_max": 75
    },
    "water_level": {
      "tank_height_cm": 30.0,
      "sensor_offset_cm": 3.0,
      "min_safe_level_cm": 2.0,
      "refill_warning_pct": 25.0
    },
    "voltage": {
      "min_warning": 4.5,
      "max_warning": 5.5
    },
    "battery": {
      "min_warning": 3.3,
      "optimal_min": 3.7
    },
    "temperature": {
      "optimal_max": 55.0,
      "high_warning": 70.0
    },
    "environmental": {
      "sht30_enabled": false,
      "bh1750_enabled": false,
      "ldr_enabled": false
    }
  },
  "timing": {
    "startup_delay_sec": 30,
    "check_interval_sec": 600,
    "sensor_read_interval_sec": 600,
    "automated_water_duration_sec": 5,
    "manual_water_duration_sec": 5,
    "pump_speed_pct": 60
  },
  "safety": {
    "max_continuous_pump_sec": 60,
    "min_time_between_cycles_sec": 300,
    "daily_watering_limit": {
      "enabled": true,
      "max_seconds_per_day": 93
    },
    "night_watering_protection": {
      "enabled": true,
      "start_hour": 22,
      "end_hour": 9
    }
  },
  "wifi": {
    "modem_sleep": true,
    "tx_power": 78,
    "force_20mhz": true,
    "radio_profile_v3": true
  }
}
